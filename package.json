{
  "name": "@zhiliangtech/deskshell",
  "version": "0.18.0",
  "description": "OS runtime for agents: protocol-first kernel with declared capabilities, post-assertions, undo and audit",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deskshell": "bin/deskshell.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin/",
    "packages/",
    "schema/",
    "scripts/doctor.ts",
    "scripts/new-skill.ts",
    "scripts/verify-driver.ts",
    "scripts/make-fixture.ts",
    "apps/cli-demo/story.ts",
    "apps/cli-demo/fail-story.ts",
    "CHANGELOG.md",
    "STATUS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhiliangTech/deskshell.git"
  },
  "homepage": "https://github.com/ZhiliangTech/deskshell#readme",
  "bugs": {
    "url": "https://github.com/ZhiliangTech/deskshell/issues"
  },
  "keywords": [
    "agent",
    "computer-use",
    "uia",
    "accessibility",
    "automation",
    "undo",
    "audit"
  ],
  "scripts": {
    "regress": "node scripts/regress.ts",
    "docs": "node scripts/build-docs.ts",
    "new-skill": "node scripts/new-skill.ts",
    "demo:fs": "node apps/cli-demo/main.ts --mode preview",
    "demo:ui": "node apps/cli-demo/ui.ts --root .demo/archive --window Edge --mode preview",
    "story": "node apps/cli-demo/story.ts",
    "clock": "node scripts/clock.ts",
    "demo": "node apps/cli-demo/thirty-seconds.ts",
    "r0": "node scripts/recovery-bench.ts",
    "r0:negative": "node scripts/r0-negative-test.ts",
    "mcp": "node packages/mcp/server.ts",
    "r0:ui": "node scripts/recovery-bench-ui.ts",
    "render:terminal": "node scripts/make-terminal-svg.ts",
    "r0:remote": "node scripts/r0-remote.ts",
    "npm:public": "node scripts/publish-npm-public.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
