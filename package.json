{
  "name": "@zhiliangtech/deskshell",
  "version": "0.11.0",
  "description": "AI computer shell: protocol-first kernel with preview, verification, undo and audit",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deskshell": "bin/deskshell.mjs"
  },
  "engines": {
    "node": ">=22.18.0 <23.0.0 || >=23.6.0"
  },
  "files": [
    "bin/",
    "packages/",
    "schema/",
    "scripts/doctor.ts",
    "scripts/new-skill.ts",
    "scripts/verify-driver.ts",
    "scripts/make-fixture.ts",
    "apps/cli-demo/story.ts",
    "apps/cli-demo/fail-story.ts",
    "CHANGELOG.md",
    "STATUS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhiliangTech/deskshell.git"
  },
  "homepage": "https://github.com/ZhiliangTech/deskshell#readme",
  "bugs": {
    "url": "https://github.com/ZhiliangTech/deskshell/issues"
  },
  "keywords": [
    "agent",
    "computer-use",
    "uia",
    "accessibility",
    "automation",
    "undo",
    "audit"
  ],
  "scripts": {
    "regress": "node scripts/regress.ts",
    "docs": "node scripts/build-docs.ts",
    "new-skill": "node scripts/new-skill.ts",
    "demo:fs": "node apps/cli-demo/main.ts --mode preview",
    "demo:ui": "node apps/cli-demo/ui.ts --root .demo/archive --window Edge --mode preview",
    "story": "node apps/cli-demo/story.ts",
    "clock": "node scripts/clock.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
