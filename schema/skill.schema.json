{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deskshell.dev/schema/skill.schema.json",
  "title": "deskshell skill manifest",
  "type": "object",
  "required": ["name", "version", "description", "entry", "capabilities"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "internal": { "type": "boolean", "description": "测试/内部 skill，不在 deskshell list 中展示" },
    "platforms": {
      "type": "array",
      "items": { "enum": ["win32", "darwin", "linux"] },
      "description": "缺省表示全平台；声明后其余平台会标记为不可用"
    },
    "capabilities": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": {
            "enum": ["fs.read", "fs.write", "fs.delete", "ui.read", "ui.input", "process.exec", "net.http"]
          },
          "scope": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
