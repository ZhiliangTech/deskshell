{
  "name": "rename-batch",
  "version": "0.1.0",
  "description": "把匹配到的文件批量重命名成 prefix-001 这样的序列，目标重名时直接失败而不是覆盖",
  "entry": "./index.ts",
  "capabilities": [
    { "id": "fs.read", "scope": "{{root}}", "reason": "列出待重命名的文件" },
    { "id": "fs.write", "scope": "{{root}}", "reason": "执行重命名" }
  ]
}
